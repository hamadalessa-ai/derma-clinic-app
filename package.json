{
  "name": "derma-clinic-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:build-setup": "tsx scripts/build-setup-sql.ts",
    "db:local": "tsx scripts/db-local.ts",
    "e2e": "playwright test",
    "docs:whatsapp": "tsx scripts/build-whatsapp-doc.ts && prettier --write docs/WHATSAPP_TEMPLATES.md"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.25",
    "bidi-js": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fontkit": "^2.0.4",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
