# Copy this file to .env.local for local development.
# NEVER commit real values. On Vercel, add these under Project → Settings → Environment Variables.

# Database connection used by the app. It MUST log in as the restricted "clinic_app" role
# (never the Supabase "postgres" admin user), so Row-Level Security always applies.
# On Supabase, use the *Transaction pooler* string (port 6543) and change the user to clinic_app.<project-ref>:
#   postgresql://clinic_app.<project-ref>:<clinic_app password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://clinic_app:localdev-clinic-app@127.0.0.1:5432/derma_dev

# Admin connection: ONLY used on the developer machine / cloud workspace to build the local database and run tests.
# Not needed on Vercel.
DATABASE_URL_ADMIN=postgresql://postgres:localdev@127.0.0.1:5432/postgres

# Random secret used to sign login sessions. Generate one at least 32 characters long.
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Public address of the app, e.g. https://derma-clinic-app.vercel.app (leave empty on Vercel to auto-detect).
BETTER_AUTH_URL=http://localhost:3000

# Root domain whose subdomains are clinics: "localhost" in dev means derma.localhost → clinic "derma".
APP_ROOT_DOMAIN=localhost

# Clinic shown when the address has no clinic subdomain (e.g. the plain *.vercel.app link).
DEMO_DEFAULT_CLINIC=derma

# Demo staff password used ONLY when building the local database (the Supabase password is set in db/setup.sql).
DEMO_PASSWORD=Demo-Local-2026

# DEMO messages: when "on", verification codes are NOT sent. They are shown on screen instead,
# but ONLY for demo clinics (tenants.is_demo). A real clinic never shows codes, even with this on.
# Leave it unset for a real launch (then a real WhatsApp/SMS sender is required).
MESSAGE_DEMO_MODE=on

# Daily cleanup job (Vercel Cron → /api/cron/daily). Any long random string; Vercel sends it automatically.
CRON_SECRET=replace-with-a-long-random-string

# Staff phone notifications (Web Push). Create them on the platform owner's page /platform/push-keys
# (made in the browser; the private key is never sent anywhere). Leave empty to switch push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── WhatsApp (Phase 2b) ── Demo: MESSAGE_DEMO_MODE=on is enough (messages go to the simulator).
# Live (after Meta business verification; see docs/DEPLOY.md Part F). Secrets: token, app secret, verify token.
WHATSAPP_PROVIDER=
WHATSAPP_CLINIC=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional: links in messages use this address (else Vercel's production address).
APP_PUBLIC_URL=

# ── Alerts (optional) ── Where "something needs a person" alerts go (stuck messages, failed scheduled runs,
# server errors). A Slack / Microsoft Teams / Google Chat / Discord incoming-webhook address. Without it,
# alerts are only in the server log (Vercel → Logs, search "ops_alert"). Alerts never contain patient data.
OPS_ALERT_WEBHOOK_URL=
